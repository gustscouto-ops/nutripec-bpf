# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutripec?schema=public"
# Segredo da sessão (mínimo 32 caracteres). Gere com: openssl rand -hex 32
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais"
# Pasta das fotos de vistoria (em produção: volume persistente ou trocar por S3/GCS em src/lib/storage.ts)
STORAGE_DIR="./storage"
# Endereço público (links nos alertas)
APP_URL="http://localhost:3000"
# Alertas por e-mail (opcional; sem SMTP_HOST os envios ficam simulados)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NutriPEC BPF <alertas@seu-dominio.com.br>"
# Alertas por WhatsApp via gateway HTTP (opcional): POST {"to","message"}
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
# Protege GET /api/cron/alertas
CRON_SECRET="troque-este-segredo"
